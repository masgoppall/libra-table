{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window and connection windows (win-*): app commands, file pickers, deep links, clipboard reads and writes (copy / paste rows) and window dragging. No shell, no free filesystem access.",
  "windows": ["main", "win-*"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "deep-link:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize"
  ]
}
